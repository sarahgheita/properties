# Same Supabase project as the web app
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# URL of the deployed web app, used so the chat tab can call its /api/chat route
# instead of duplicating the Gemini integration. Leave blank during local dev if
# the web app isn't deployed yet — the chat tab will show a friendly notice.
EXPO_PUBLIC_API_BASE_URL=https://your-deployed-site.vercel.app
